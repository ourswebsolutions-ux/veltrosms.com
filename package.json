{
  "name": "rocksms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:admin": "tsx --conditions=react-server prisma/seed-admin.ts",
    "db:studio": "prisma studio",
    "catalog:sync": "tsx --conditions=react-server scripts/catalog-sync.ts",
    "orders:sweep": "tsx --conditions=react-server scripts/orders-sweep.ts",
    "payments:reconcile": "tsx --conditions=react-server scripts/payments-reconcile.ts",
    "admin:role": "tsx --conditions=react-server scripts/admin-role.ts",
    "wallet:adjust": "tsx --conditions=react-server scripts/wallet-adjust.ts",
    "provider:check": "tsx --conditions=react-server scripts/provider-check.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "flag-icons": "^7.5.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
