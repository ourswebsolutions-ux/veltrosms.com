# Copy to .env.local (development) or set in your hosting environment.
# Never commit real secrets. Everything here is read on the server only;
# nothing is exposed to the browser (no NEXT_PUBLIC_ variables are used).

# --- Database (MySQL / MariaDB via Prisma) ------------------------------------
# Use a dedicated database for this app. Apply migrations: npm run db:migrate
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/rocksms"

# --- Application ------------------------------------------------------------------
# Public origin used in email links. An https:// value also makes the session
# cookie __Host- prefixed and Secure.
APP_URL=http://localhost:3000
# true only behind a reverse proxy that sets X-Forwarded-For (enables per-IP limits).
TRUST_PROXY=false

# --- Email (SMTP) ---------------------------------------------------------------
# Without SMTP_HOST, development writes emails to .data/outbox/ instead of sending.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, an app password (not the account password),
# and MAIL_FROM using the same Gmail address.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="VirtuMSG <no-reply@example.com>"
# Force the local outbox even in production mode (local testing only).
# MAIL_OUTBOX=true

# --- Money --------------------------------------------------------------------------
PLATFORM_CURRENCY=USD      # wallets and customer prices
PROVIDER_CURRENCY=USD      # what the provider bills in
PROVIDER_FX_RATE=1         # platform units per 1 provider unit
PRICE_MARKUP_PERCENT=20    # customer price = cost × FX × (1 + markup%)
PRICE_MIN_MARGIN=0.01      # …and at least cost + this margin

# --- Upstream number provider -------------------------------------------------------
# "grizzly" (API documented at https://grizzlysms.com/docs) or "none".
SMS_PROVIDER=grizzly
# Your provider API key (from the provider account's Settings). Required for any live data.
# GRIZZLY_API_KEY=
# GRIZZLY_API_URL=https://api.grizzlysms.com/stubs/handler_api.php
# Max requests/second we send to the provider (per app instance).
PROVIDER_MAX_RPS=8
# Full catalog refresh interval (the full price list is ~3.6 MB / ~30-70 s).
CATALOG_SYNC_MINUTES=15

# --- Wallet top-ups (payments) --------------------------------------------------------
# "manual" (default): customers send money by Easypaisa / JazzCash and submit the
# transaction ID; an administrator approves it in /admin/topups (see docs/PAYMENTS.md).
# The receiving account and WhatsApp number are edited in Admin → Settings.
# "none" disables top-ups. Future Easypaisa/JazzCash API credentials will be added here.
PAYMENT_PROVIDER=manual
# New manual top-up requests are also emailed here (optional).
# ADMIN_NOTIFY_EMAIL=admin@example.com
TOPUP_MIN_AMOUNT=1         # platform currency, whole cents
TOPUP_MAX_AMOUNT=1000
# Gateway (future API) providers only:
TOPUP_FEE_PERCENT=0
TOPUP_FEE_FIXED=0
PAYMENT_EXPIRY_MINUTES=60

# --- Administrator setup (server shell only) --------------------------------------------
# Admin seeder (safe to re-run, any environment): npm run db:seed:admin
#   Creates ADMIN_EMAIL as an administrator, or makes an existing account admin/active/verified.
#   With ADMIN_PASSWORD set, that becomes the initial password (only its hash is stored —
#   remove it afterwards); without it, a password-setup link is emailed to ADMIN_EMAIL.
#   An existing admin's password is never changed unless ADMIN_RESET_PASSWORD=true.
# ADMIN_EMAIL=zh613781@gmail.com
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=
# ADMIN_RESET_PASSWORD=false
# One-off alternative: npm run admin:role -- --email admin@example.com --create
#   (uses ADMIN_SETUP_PASSWORD the same way). Never commit a password.
# ADMIN_SETUP_PASSWORD=
# Development seed only (npm run db:seed); a random password is generated if unset.
# SEED_DEV_PASSWORD=
